{
  "tasks": {
    "dev": "deno run --watch main.ts",
    "webapp": "deno run --allow-net --allow-read webapp.ts",
    "webapp:dev": "deno run --allow-net --allow-read --watch webapp.ts"
    "worker:serve": "denoflare serve worker.ts --port 8787",
    "worker:push": "denoflare push rosetta-translate",
    "worker:tail": "denoflare tail rosetta-translate"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  }
}
